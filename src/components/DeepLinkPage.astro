---
const { config, pageTitle } = Astro.props;
const canonicalUrl = Astro.url.href;
const title = pageTitle ?? `${config.appName} Link`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta name="description" content={config.metaDescription} />
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${config.appName} - ${config.appTagline}`} />
    <meta property="og:description" content={config.metaDescription} />
    <meta property="og:image" content={config.ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.appName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <main class="panel">
      <div class="brand">{config.appName}</div>
      <h1>Opening your link…</h1>
      <p>If nothing happens, use the button below.</p>
      <a class="button" id="manual-redirect" href="#">Open the app</a>
      <p class="meta">This page is for app deep links and account recovery.</p>
    </main>

    <script define:vars={{ config }}>
      (function() {
        "use strict";

        function detectPlatform() {
          const ua = navigator.userAgent || navigator.vendor || window.opera || "";

          if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
            return "ios";
          }

          if (/android/i.test(ua)) {
            return "android";
          }

          return "web";
        }

        function joinPaths(basePath, path) {
          const trimmedBase = basePath.replace(/\/+$/, "");
          const trimmedPath = path.replace(/^\/+/, "");
          if (!trimmedBase) return `/${trimmedPath}`;
          if (!trimmedPath) return trimmedBase || "/";
          return `${trimmedBase}/${trimmedPath}`;
        }

        function buildTargetPath(url) {
          const explicitPath = url.searchParams.get("path");
          if (explicitPath) {
            url.searchParams.delete("path");
            return {
              path: explicitPath,
              search: url.searchParams.toString(),
              hash: url.hash
            };
          }

          return {
            path: url.pathname,
            search: url.searchParams.toString(),
            hash: url.hash
          };
        }

        function buildAppUrl({ path, search, hash }) {
          const normalizedPath = path.replace(/^\/+/, "");
          const query = search ? `?${search}` : "";
          return `${config.appScheme}://${normalizedPath}${query}${hash || ""}`;
        }

        function buildWebUrl({ path, search, hash }) {
          try {
            const baseUrl = new URL(config.fallbackWebUrl);
            baseUrl.pathname = joinPaths(baseUrl.pathname, path);
            baseUrl.search = search ? `?${search}` : "";
            baseUrl.hash = hash || "";
            return baseUrl.toString();
          } catch {
            return config.fallbackWebUrl;
          }
        }

        function redirect() {
          const url = new URL(window.location.href);
          const target = buildTargetPath(url);
          const platform = detectPlatform();

          if (platform === "web") {
            const webUrl = buildWebUrl(target);
            window.location.replace(webUrl);
            return;
          }

          const appUrl = buildAppUrl(target);
          const fallbackUrl =
            platform === "ios" ? config.iosAppStoreUrl : config.androidPlayStoreUrl;

          window.location.href = appUrl;
          setTimeout(function() {
            // If the app opened, the browser was backgrounded and this page
            // is hidden — don't drag the user off to the store as well.
            if (!document.hidden) {
              window.location.replace(fallbackUrl);
            }
          }, 1500);
        }

        const manualLink = document.getElementById("manual-redirect");
        if (manualLink) {
          manualLink.addEventListener("click", function(event) {
            event.preventDefault();
            redirect();
          });
        }

        setTimeout(redirect, 300);
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    background: radial-gradient(circle at top, #f7f2e8, #e6ddcf);
    color: #1d1b16;
  }

  .panel {
    width: min(420px, 90vw);
    background: #fffaf0;
    border: 1px solid #e4d6c3;
    border-radius: 24px;
    padding: 2.5rem 2.5rem 2rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(41, 29, 14, 0.12);
  }

  .brand {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
    color: #78624a;
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: 1.9rem;
  }

  p {
    margin: 0.5rem 0 1.5rem;
    color: #4b3d2b;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.8rem;
    background: #2e2214;
    color: #fdf5e6;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(46, 34, 20, 0.25);
  }

  .meta {
    font-size: 0.85rem;
    color: #78624a;
    margin-top: 1.75rem;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
