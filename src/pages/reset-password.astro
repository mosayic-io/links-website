---
import siteConfig from "@config";

const canonicalUrl = Astro.url.href;
const pageTitle = "Reset Your Password";
const appName = siteConfig.appName;
const ogImageUrl = siteConfig.ogImageUrl;
const openAppUrl = `${siteConfig.appScheme}://`;
const supabaseUrl = siteConfig.supabaseUrl;
const supabasePublishableKey = siteConfig.supabasePublishableKey;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <meta name="description" content={`Reset your ${appName} password.`} />
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${appName} - Password Reset`} />
    <meta property="og:description" content={`Reset your ${appName} password.`} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={appName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <main class="card">
      <div class="brand">{appName}</div>
      <h1>Reset your password</h1>
      <p class="lead">Choose a new password for your account.</p>

      <form id="reset-form" class="form" novalidate>
        <label class="field">
          <span>New password</span>
          <div class="input-wrap">
            <input
              id="password"
              name="password"
              type="password"
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              required
            />
            <button type="button" class="ghost" data-toggle="password">Show</button>
          </div>
        </label>

        <label class="field">
          <span>Confirm password</span>
          <div class="input-wrap">
            <input
              id="confirm-password"
              name="confirmPassword"
              type="password"
              minlength="8"
              autocomplete="new-password"
              placeholder="Re-enter your password"
              required
            />
            <button type="button" class="ghost" data-toggle="confirm-password">Show</button>
          </div>
        </label>

        <button class="primary" type="submit">Reset password</button>
      </form>

      <p id="status" class="status" role="status" aria-live="polite"></p>
      <a class="success-action" id="success-action" href={openAppUrl} hidden>
        Open the app
      </a>
      <p class="meta">This link expires shortly after it is sent.</p>
    </main>

    <div id="supabase-config" data-url={supabaseUrl} data-key={supabasePublishableKey} hidden></div>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const configEl = document.getElementById("supabase-config")!;
      const statusEl = document.getElementById("status")!;
      const form = document.getElementById("reset-form")!;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const confirmInput = document.getElementById("confirm-password") as HTMLInputElement;
      const successAction = document.getElementById("success-action")!;

      const supabase = createClient(configEl.dataset.url!, configEl.dataset.key!);
      function setStatus(message: string, tone = "info") {
        statusEl.textContent = message;
        statusEl.dataset.tone = tone;
      }

      function parseTokens() {
        const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ""));
        const queryParams = new URLSearchParams(window.location.search);

        return {
          accessToken: hashParams.get("access_token") || queryParams.get("access_token"),
          refreshToken: hashParams.get("refresh_token") || queryParams.get("refresh_token"),
          type: hashParams.get("type") || queryParams.get("type"),
        };
      }

      function togglePassword(targetId: string, button: HTMLElement) {
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (!input) return;
        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";
        button.textContent = isPassword ? "Hide" : "Show";
      }

      document.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          togglePassword(button.dataset.toggle!, button);
        });
      });

      const { accessToken, refreshToken, type } = parseTokens();
      if (!accessToken || !refreshToken || type !== "recovery") {
        setStatus("This reset link is missing or expired. Request a new one.", "error");
        (form.querySelector("button[type='submit']") as HTMLButtonElement).disabled = true;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const password = passwordInput.value.trim();
        const confirm = confirmInput.value.trim();

        if (password.length < 8) {
          setStatus("Password must be at least 8 characters.", "error");
          return;
        }

        if (password !== confirm) {
          setStatus("Passwords do not match.", "error");
          return;
        }

        setStatus("Updating your password…", "info");

        const { error: sessionError } = await supabase.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken,
        });

        if (sessionError) {
          setStatus("This reset link is no longer valid. Request a new one.", "error");
          return;
        }

        const { error } = await supabase.auth.updateUser({ password });
        if (error) {
          setStatus("We couldn't reset your password. Please try again.", "error");
          return;
        }

        setStatus("Password reset successfully. You can open the app now.", "success");
        form.reset();
        successAction.hidden = false;
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    background: radial-gradient(circle at top, #f7f2e8, #e6ddcf);
    color: #1d1b16;
  }

  .card {
    width: min(520px, 92vw);
    background: #fffaf0;
    border: 1px solid #e4d6c3;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(41, 29, 14, 0.12);
  }

  .brand {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
    color: #78624a;
  }

  h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.8rem, 2vw + 1.2rem, 2.4rem);
  }

  .lead {
    margin: 0 0 2rem;
    color: #4b3d2b;
  }

  .form {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
  }

  .field span {
    font-size: 0.95rem;
    color: #2e2214;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #fdf7ea;
    border: 1px solid #ead9c2;
    border-radius: 16px;
    padding: 0.6rem 0.8rem;
  }

  input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    color: #1d1b16;
    outline: none;
  }

  input::placeholder {
    color: #9a846c;
  }

  .ghost {
    border: none;
    background: transparent;
    color: #6f5a42;
    font-weight: 600;
    cursor: pointer;
  }

  .primary {
    border: none;
    border-radius: 999px;
    padding: 0.9rem 1.8rem;
    font-weight: 600;
    font-size: 1rem;
    background: #2e2214;
    color: #fdf5e6;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 20px rgba(46, 34, 20, 0.25);
  }

  .primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .status {
    min-height: 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
    color: #4b3d2b;
  }

  .success-action {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.8rem 1.6rem;
    background: #f0e4d3;
    color: #2e2214;
    text-decoration: none;
    font-weight: 600;
  }

  .status[data-tone="error"] {
    color: #8c3a2b;
  }

  .status[data-tone="success"] {
    color: #2f5a3a;
  }

  .meta {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: #7a644b;
  }

  @media (max-width: 540px) {
    .card {
      padding: 2rem 1.5rem;
    }

    .input-wrap {
      flex-direction: column;
      align-items: stretch;
    }

    .ghost {
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary {
      transition: none;
    }
  }
</style>
